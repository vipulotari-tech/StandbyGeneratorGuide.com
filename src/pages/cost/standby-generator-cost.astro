---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TopicClusterLinks from '../../components/seo/TopicClusterLinks.astro';
import { MODEL_SPECS } from '../../data/model-specs';

const pricedModels = MODEL_SPECS.filter((model) => model.startingMsrpUsd !== undefined);
const toc = [
  { id: 'quick-answer', label: 'Quick cost answer' },
  { id: 'price-scope', label: 'Separate equipment from installation' },
  { id: 'current-msrp', label: 'Selected current model MSRPs' },
  { id: 'installed-ranges', label: 'Published installed ranges' },
  { id: 'what-changes', label: 'What changes a quote' },
  { id: 'line-items', label: 'Planning references by line item' },
  { id: 'quote-checklist', label: 'Quote comparison checklist' },
  { id: 'cost-faq', label: 'Common cost questions' },
  { id: 'ownership', label: 'Fuel and maintenance' },
