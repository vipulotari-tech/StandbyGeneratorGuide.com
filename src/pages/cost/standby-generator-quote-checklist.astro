---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FAQSection from '../../components/ui/FAQSection.astro';

const toc = [
  { id: 'before-you-compare', label: 'Before you compare quotes' },
  { id: 'checklist', label: '16-line quote checklist' },
  { id: 'comparison-sheet', label: 'Side-by-side proposal sheet' },
  { id: 'red-flags', label: 'Proposal red flags' },
  { id: 'handoff', label: 'What to get at handoff' },
  { id: 'faq', label: 'Quote questions' },
];

const quoteChecklistItems = [
  {
    "name": "Generator",
    "description": "Exact manufacturer, model, voltage/phase, fuel, and fuel-specific standby rating."
  },
  {
    "name": "Transfer equipment",
    "description": "Exact ATS / switch model, amperage, service-entrance rating where applicable, and whether it is included in the quoted package."
  },
  {
    "name": "Backed-up loads",
    "description": "Circuits / loads intended to operate, plus any explicit exclusions."
  },
  {
    "name": "Load management",
    "description": "Modules, priorities, sequencing assumptions, and which large loads may be shed or delayed."
  },
  {
    "name": "Electrical service work",
    "description": "Panel/service assessment, required modifications, disconnect/service-equipment scope, and utility coordination if needed."
  },
  {
    "name": "Conductors and route",
    "description": "Conduit, wiring route, trenching, penetrations, restoration, and distance assumptions."
  },
  {
    "name": "Fuel capacity check",
    "description": "Who verifies available pressure/flow or propane supply for the exact generator and planned connected loads."
  },
  {
    "name": "Fuel-line work",
    "description": "Pipe / regulator / meter / tank work, trenching, connections, testing, and items assigned to another trade or utility."
  },
  {
    "name": "Generator location",
    "description": "Proposed location and confirmation that manufacturer clearances, service access, drainage, openings, and local rules will be checked."
  },
  {
    "name": "Base and site preparation",
    "description": "Approved pad/base, grading, drainage, lifting/access, vegetation or obstruction work, and restoration."
  },
  {
    "name": "Permits and inspections",
    "description": "Which permits, applications, inspection fees, utility approvals, and HOA/property approvals are included or owner-paid."
  },
  {
    "name": "Startup and commissioning",
    "description": "Initial setup, transfer test / simulated outage where appropriate, operating checks, and owner orientation."
  },
  {
    "name": "Accessories",
    "description": "Battery, cold-weather kits, monitoring hardware/subscription, surge protection, fascia, load modules, or other accessories."
  },
  {
    "name": "Warranty and registration",
    "description": "Generator and ATS warranty documents, registration/activation responsibility, coverage start, and local warranty-service contact."
  },
  {
    "name": "Exclusions and allowances",
    "description": "Every item not included, every provisional allowance, and conditions that can change price after work begins."
  },
  {
    "name": "Commercial terms",
    "description": "Taxes, payment schedule, deposit, estimated schedule assumptions, cancellation terms, and written change-order process."
  }
];

const proposalFields = [
  'Generator + fuel rating',
  'ATS / transfer equipment',
  'Backed-up loads',
  'Load management',
  'Electrical work',
  'Fuel work',
  'Site / pad work',
  'Permits / inspections',
  'Commissioning',
  'Warranty / service',
  'Allowances / exclusions',
  'Total written price',
];
---
<ArticleLayout
  title="Standby Generator Quote Checklist: 16 Line Items to Compare"
  description="A printable-style checklist for comparing standby-generator proposals by exact equipment, electrical and fuel scope, site work, permits, commissioning, warranty, exclusions, and change-order terms."
  category="Cost" categoryHref="/cost/" updated="2026-10-05" verified="2026-10-05" image="/images/cost-install-quote.webp" readingTime="8 min read" toc={toc}
  takeaways={[
    'Compare proposals on the same backed-up loads and exact equipment wherever possible; headline project totals are not useful until scope is aligned.',
    'Require generator, transfer-switch, fuel, electrical, site-work, permit, commissioning, warranty, and exclusion details in writing.',
    'Treat this as a completeness checklist, not a substitute for a licensed contractor, utility, fuel supplier, permit authority, or the exact manufacturer installation instructions.',
  ]}
  sources={[
    { label: 'Generac: backup generator installation process and quote consultation topics', href: 'https://www.generac.com/resources/home-management/backup-generator-installation/', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'Cummins: home generator FAQ — installation, permitting, and warranty overview', href: 'https://www.cummins.com/en-na/na/generators/home-standby/home-generator-faq', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'Champion: site survey, installation scope, placement and fuel-service considerations', href: 'https://www.championpowerequipment.com/news-updates/what-a-site-survey-is-and-why-it-is-important-when-purchasing-a-home-standby-generator/', type: 'Manufacturer', verified: '2026-10-05' },
    { label: 'Generac G0073270 official 22–28 kW specification sheet', href: 'https://productmanuals.generac.com/api/manualfiles/G0073270/A0005151077/0', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'KOHLER/Rehlko 26RCA/26RCAL official specification sheet', href: 'https://techcomm.rehlko.com/techcomm/pdf/g4315.pdf', type: 'Manufacturer', verified: '2026-10-04' },
  ]}
  related={[
    { href: '/cost/standby-generator-cost/', title: 'Standby generator cost guide', description: 'Separate equipment MSRP from installed-project estimates and site variables.', category: 'Cost' },
    { href: '/installation/what-to-expect/', title: 'Installation: what to expect', description: 'Understand the project sequence from site assessment through commissioning.', category: 'Installation' },
    { href: '/comparisons/standby-generator-warranty-comparison/', title: 'Standby generator warranty comparison', description: 'Compare exact-model warranty summaries without treating warranty length as a reliability score.', category: 'Comparisons' },
  ]}
>
  <figure class="not-prose my-8 overflow-hidden rounded-xl border border-[#d9e0ea] bg-[#f7f9fc]"><img src="/images/user-editorial/generator-quote-review-at-home.webp" alt="Homeowner reviewing a printed contractor proposal at a kitchen table" width="1536" height="1024" loading="lazy" decoding="async" class="block h-auto w-full" /><figcaption class="px-4 py-3 text-sm leading-relaxed text-gray-600">Illustrative quote review. Ask contractors to list exact generator, transfer switch, electrical and fuel work, permits and exclusions.</figcaption></figure>
  <aside class="planning-notice"><strong>Compare three quotes side by side.</strong> <a href="/planning/quotes/">Open the planning tool →</a> Use documented inputs and take the assumptions to your installer.</aside>

  <section id="before-you-compare">
    <h2>Before you compare quotes, align the job</h2>
    <p>Two proposals can show very different totals while describing different projects. One may include a service-rated automatic transfer switch, panel changes, trenching, gas work, permits, startup, and owner handoff; another may show only the generator plus basic labor. Before comparing price, ask each contractor to price the same backed-up loads and to identify every exact model number and included work item.</p>
    <p>Generac’s own installation guidance says the at-home consultation should cover placement, site requirements, system requirements, fuel source and connection, and property restrictions. Champion’s site-survey guidance separately identifies the generator, automatic transfer switch, power-management modules, placement, electrical connections, fuel plumbing, fittings, batteries, and site-specific code considerations as parts of the project scope. Cummins likewise says installation should be handled by a certified electrician in compliance with local building codes and proper permitting. Those manufacturer statements support the basic principle behind this checklist: the written proposal needs to describe the complete site-specific system, not just the generator cabinet.</p>
  </section>

  <section id="checklist">
    <h2>The 16-line standby-generator quote checklist</h2>
    <p>Ask the contractor to mark each item as <strong>included</strong>, <strong>excluded</strong>, or <strong>allowance / pending site verification</strong>. If a line does not apply, have the proposal say so rather than leaving it ambiguous.</p>
    <div class="quote-checklist not-prose">
      <div class="quote-checklist-intro">
        <div>
          <p class="quote-checklist-kicker">THE WRITTEN-SCOPE CHECKLIST</p>
          <p class="quote-checklist-intro-title">Make every line item clear before signing.</p>
          <p class="quote-checklist-intro-description">16 essentials to verify with both installers. Ask for the exact scope and status in the written proposal.</p>
        </div>
        <a class="quote-checklist-jump" href="#comparison-sheet">Open A/B worksheet <span aria-hidden="true">↗</span></a>
      </div>

      <ol class="quote-checklist-cards" aria-label="Sixteen standby generator quote checklist items">
        {quoteChecklistItems.map((item,index)=>(
          <li class="quote-checklist-card">
            <div class="quote-checklist-card-heading">
              <span class="quote-checklist-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
              <h3>{item.name}</h3>
            </div>
            <p>{item.description}</p>
          </li>
        ))}
      </ol>

      <div class="quote-checklist-table-wrap" role="region" aria-label="Sixteen line item quote checklist table" tabindex="0">
        <table class="quote-checklist-table">
          <caption class="sr-only">Sixteen line items to compare on standby generator proposals</caption>
          <thead>
            <tr><th scope="col">#</th><th scope="col">Line item</th><th scope="col">What should be stated in writing</th></tr>
          </thead>
          <tbody>
            {quoteChecklistItems.map((item,index)=>(
              <tr><td>{String(index+1).padStart(2,'0')}</td><th scope="row">{item.name}</th><td>{item.description}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="quote-checklist-footnote"><strong>No unanswered assumptions.</strong> Have each installer document what is included, excluded or still subject to an allowance or site verification.</p>
    </div>
  </section>

  <section id="comparison-sheet">
    <h2>Side-by-side proposal comparison sheet</h2>
    <p>Use this blank worksheet after both contractors have answered the 16 lines above. Print the page or save it as a PDF from your browser.</p>
    <div class="proposal-worksheet not-prose">
      <div class="proposal-workflow">
        <div>
          <p class="proposal-eyebrow">HOMEOWNER DECISION WORKSHEET</p>
          <p class="proposal-instructions">12 essentials • 2 proposals • One consistent scope. Write the details from each contractor’s signed quote, then compare on paper.</p>
        </div>
        <div class="proposal-actions">
          <button type="button" id="print-proposal-sheet" class="proposal-print-button" hidden>
            <span aria-hidden="true">↗</span> Print / Save as PDF
          </button>
          <a class="proposal-digital-link" href="/planning/quotes/">Compare quotes digitally <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <ol class="proposal-card-grid" aria-label="Twelve fields for comparing two generator proposals">
        {proposalFields.map((field, index) => (
          <li class="proposal-card">
            <div class="proposal-card-heading">
              <span class="proposal-card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{field}</h3>
            </div>
            <div class="proposal-card-responses">
              <div class="proposal-card-response">
                <span class="proposal-letter proposal-letter-a">A</span>
                <span class="proposal-field-label">Proposal A</span>
                <span class="proposal-writing-line" aria-hidden="true"></span>
              </div>
              <div class="proposal-card-response">
                <span class="proposal-letter proposal-letter-b">B</span>
                <span class="proposal-field-label">Proposal B</span>
                <span class="proposal-writing-line" aria-hidden="true"></span>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="proposal-table-wrap" role="region" tabindex="0" aria-label="Blank proposal comparison table">
        <table class="proposal-comparison-table">
          <caption class="sr-only">Twelve-field printable comparison of proposal A and proposal B</caption>
          <thead>
            <tr><th scope="col">Comparison field</th><th scope="col">Proposal A</th><th scope="col">Proposal B</th></tr>
          </thead>
          <tbody>
            {proposalFields.map((field, index) => (
              <tr>
                <th scope="row"><span class="proposal-row-number">{String(index + 1).padStart(2, '0')}</span>{field}</th>
                <td><span class="sr-only">Blank entry for proposal A</span></td>
                <td><span class="sr-only">Blank entry for proposal B</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="proposal-footnote"><strong>Compare like for like.</strong> An empty cell is an unanswered question—not proof that the item is included. Ask both installers to confirm exclusions and allowances in writing.</p>
    </div>
    <p class="mt-4">A lower total may still be the better proposal, but only after scope is normalized. If one contractor has included panel work, gas capacity changes, a service-rated ATS, or permit fees that another omitted, the totals are not directly comparable.</p>
  </section>

  <section id="red-flags">
    <h2>Proposal red flags worth clarifying before signing</h2>
    <ul>
      <li>The proposal says only “22 kW generator” with no exact model or fuel-specific rating.</li>
      <li>The switch is described only as “200 A” without a model number or package scope.</li>
      <li>Fuel work is marked “by others” but no one is named as responsible for capacity, routing, or final connection.</li>
      <li>Permits or inspections are assumed but not assigned to contractor or owner.</li>
      <li>Panel/service changes, trenching, restoration, or load-management modules are left as open-ended extras.</li>
      <li>Warranty length is advertised, but the proposal does not identify the exact generator/ATS warranty documents or local service path.</li>
      <li>A large allowance appears without a stated quantity, unit price, or condition for reconciling the final bill.</li>
      <li>Change-order terms are missing even though major site conditions remain unknown.</li>
    </ul>
  </section>

  <section id="handoff">
    <h2>What to ask for at project handoff</h2>
    <p>Keep a permanent folder with the exact model and serial numbers, current operator and installation manuals, permits/inspection records, commissioning or startup records supplied by the installer, warranty/activation documents, service contact, and any load-management configuration notes. The owner should also know where the emergency shutdown instructions are and which qualified service provider to call.</p>
    <p>This checklist does not authorize electrical, gas, fuel, or transfer-equipment work. Use qualified professionals and the exact manufacturer instructions for the installed system.</p>
  </section>

  <section id="faq">
    <span class="sr-only">FAQ anchor</span>
    <FAQSection items={[
      { q: 'How many generator quotes should I get?', a: 'There is no universal number. When practical, more than one comparable written proposal can reveal differences in equipment scope, site assumptions, exclusions, and service support. The important part is comparing the same backed-up loads and clearly stated equipment.' },
      { q: 'Should the quote include the transfer switch?', a: 'The proposal should explicitly say whether a transfer switch is included and identify its exact model and rating. Some generator product prices or packages include a switch and others do not, so never infer it from the generator kW rating or headline price.' },
      { q: 'What if the contractor cannot price gas or electrical changes yet?', a: 'The proposal can use an allowance or clearly marked pending item, but it should say what information is missing, who will verify it, and how the final price will be adjusted.' },
      { q: 'Is the lowest bid the best choice?', a: 'Not necessarily. Normalize equipment and scope first, then compare price, local service, warranty path, schedule assumptions, and written exclusions. This site does not select contractors or recommend a universal winning bid.' },
    ]} />
  </section>
</ArticleLayout>


<script>
  const printButton = document.querySelector<HTMLButtonElement>('#print-proposal-sheet');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style>
  /* The editable-on-paper worksheet is intentionally distinct from ordinary
     comparison tables. Never apply generic mobile-card-table row transformations. */
  .proposal-worksheet {
    min-width: 0;
    margin: 1.5rem 0 2rem;
    border: 1px solid #dae4dc;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 10px 32px rgba(22, 49, 37, 0.055);
    overflow: hidden;
  }
  .proposal-workflow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.15rem 1.5rem;
    padding: clamp(1.15rem, 3vw, 1.7rem);
    border-bottom: 1px solid #dce7df;
    background: linear-gradient(130deg, #f2f7f3, #fcfdfa);
  }
  .proposal-eyebrow {
    margin: 0 0 0.35rem !important;
    font-size: 0.71rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.45;
    color: #38664e;
  }
  .proposal-instructions {
    max-width: 53ch;
    margin: 0 !important;
    font-size: 0.92rem;
    line-height: 1.65;
    color: #344d40;
  }
  .proposal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }
  .proposal-print-button, .proposal-digital-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0.72rem 0.95rem;
    border-radius: 0.45rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.4;
    cursor: pointer;
    text-align: center;
    text-decoration: none !important;
  }
  .proposal-print-button[hidden] { display: none !important; }
  .proposal-print-button {
    border: 1px solid #203b34;
    color: #fff;
    background: #203b34;
  }
  .proposal-print-button:hover { background: #345749; }
  .proposal-digital-link {
    border: 1px solid #a6bdb0;
    color: #203b34 !important;
    background: #fff;
  }
  .proposal-digital-link:hover { background: #e7f0e9; }
  .proposal-print-button:focus-visible, .proposal-digital-link:focus-visible,
  .proposal-table-wrap:focus-visible {
    outline: 3px solid #da9b44;
    outline-offset: 3px;
  }
  .proposal-card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1rem !important;
    margin: 0 !important;
    list-style: none !important;
    background: #fafcf9;
  }
  .proposal-card {
    min-width: 0;
    margin: 0 !important;
    padding: 1rem 1.05rem;
    border: 1px solid #dde7dd;
    border-radius: 0.75rem;
    background: #fff;
  }
  .proposal-card-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #e5ece6;
  }
  .proposal-card-number {
    flex: 0 0 auto;
    color: #aa763c;
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }
  .proposal-card h3 {
    margin: 0 !important;
    color: #1e3b30;
    font-size: clamp(0.98rem, 2.2vw, 1.1rem);
    font-weight: 750;
    line-height: 1.45;
  }
  .proposal-card-responses { display: grid; grid-template-columns: minmax(0,1fr); }
  .proposal-card-response {
    display: grid;
    min-width: 0;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.55rem;
    row-gap: 0.25rem;
    padding: 0.65rem 0 0.35rem;
  }
  .proposal-card-response + .proposal-card-response {
    border-top: 1px solid #eef2ee;
    margin-top: 0.3rem;
  }
  .proposal-letter {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 0.32rem;
    font-weight: 800;
    font-size: 0.75rem;
  }
  .proposal-letter-a { color: #fff; background: #244a3b; }
  .proposal-letter-b { color: #564021; background: #f2e5ce; }
  .proposal-field-label {
    color: #41564a;
    font-size: 0.83rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .proposal-writing-line {
    grid-column: 1 / -1;
    width: 100%;
    height: 1.4rem;
    border-bottom: 1px solid #a7b9a9;
  }
  .proposal-table-wrap { display: none; }
  .proposal-footnote {
    margin: 0 !important;
    padding: 0.95rem 1.15rem;
    border-top: 1px solid #e0e9e1;
    background: #f8f8f3;
    color: #41584a;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .proposal-footnote strong { color: #203b34; }
  @media screen and (min-width: 720px) and (max-width: 1199px) {
    .proposal-card-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .proposal-actions { width: 100%; }
  }
  @media screen and (min-width: 1200px) {
    .proposal-card-grid { display: none; }
    .proposal-table-wrap { display: block; overflow-x: auto; }
    .proposal-comparison-table {
      width: 100%;
      min-width: 620px;
      border-collapse: collapse;
      table-layout: fixed;
      margin: 0;
      font-size: 0.85rem;
    }
    .proposal-comparison-table th, .proposal-comparison-table td {
      border: 1px solid #dfe7de;
      padding: 0.7rem 0.85rem;
      text-align: left;
    }
    .proposal-comparison-table thead th {
      background: #203b34;
      color: #fff;
      font-weight: 750;
      font-size: 0.83rem;
    }
    .proposal-comparison-table tbody th {
      width: 40%;
      color: #203b34;
      font-weight: 700;
      background: #fff;
    }
    .proposal-comparison-table tbody tr:nth-child(even) { background: #f7faf7; }
    .proposal-comparison-table tbody td { height: 3.1rem; }
    .proposal-comparison-table thead th:first-child { width: 40%; }
    .proposal-comparison-table thead th:not(:first-child) { width: 30%; }
    .proposal-row-number {
      display: inline-block;
      margin-right: 0.75rem;
      color: #916a39;
      font-size: 0.69rem;
      font-weight: 800;
    }
  }
  @media screen and (max-width: 430px) {
    .proposal-workflow { padding: 1rem; }
    .proposal-actions { display: grid; grid-template-columns: minmax(0,1fr); width: 100%; }
    .proposal-card-grid { padding: 0.65rem !important; gap: 0.7rem; }
    .proposal-card { padding: 0.9rem 0.95rem; }
  }
  @media print {
    .proposal-worksheet {
      box-shadow: none;
      border: 0;
      border-radius: 0;
      overflow: visible;
      break-inside: auto !important;
    }
    .proposal-workflow {
      display: block;
      padding: 0.5rem 0;
      border: 0;
      background: #fff !important;
    }
    .proposal-eyebrow { color: #444; font-size: 8pt; }
    .proposal-instructions { max-width: none; color: #222; font-size: 9pt; }
    .proposal-actions, .proposal-card-grid { display: none !important; }
    .proposal-table-wrap { display: block !important; overflow: visible !important; }
    .proposal-comparison-table {
      display: table !important;
      width: 100%;
      min-width: 0;
      border-collapse: collapse;
      table-layout: fixed;
      margin: 0 !important;
      font-size: 9pt;
    }
    .proposal-comparison-table thead { display: table-header-group; }
    .proposal-comparison-table th, .proposal-comparison-table td {
      padding: 0.4rem;
      border: 1px solid #555 !important;
      color: #111 !important;
      text-align: left;
    }
    .proposal-comparison-table thead th { background: #e6eae6 !important; color: #000 !important; }
    .proposal-comparison-table thead th:first-child { width: 40%; }
    .proposal-comparison-table thead th:not(:first-child) { width: 30%; }
    .proposal-comparison-table tbody th { font-weight: 650; }
    .proposal-comparison-table tbody tr { break-inside: avoid; }
    .proposal-comparison-table tbody td { height: 2.6rem; }
    .proposal-row-number { margin-right: 0.35rem; color: #555; }
    .proposal-footnote {
      margin: 0.45rem 0 0 !important;
      padding: 0.4rem 0;
      border: 0;
      background: #fff !important;
      font-size: 8pt;
    }
  }
</style>

<style>
  /* Dedicated read-only checklist: avoid the generic table-as-cards stylesheet,
     which repeats headings three times for every item on mobile. */
  .quote-checklist {
    min-width: 0;
    overflow: hidden;
    margin: 1.4rem 0 2.1rem;
    border: 1px solid #d9e5dc;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 12px 35px rgba(27, 58, 41, 0.045);
  }
