---
import BaseLayout from '../../layouts/BaseLayout.astro';

const generatorDetails = [
  'Generator model / serial',
  'ATS model',
  'Fuel',
  'Manual / revision',
  'Service provider / contact',
  'Exercise schedule from manual',
  'Next inspection',
];
const serviceFields = [
  'Date',
  'Run hours',
  'Work, parts / oil used, alarms',
  'Performed by',
  'Next due (date / hours)',
];
---
<BaseLayout
  title="Printable Generator Maintenance Log"
  description="Fill a private generator maintenance log online, then print or save a PDF with your model, service records, running hours and due dates."
>
  <article class="editorial-container publication-section maintenance-log">
    <header class="log-header">
      <p class="log-eyebrow">Standby Generator Guide / Homeowner worksheet</p>
      <h1>Generator maintenance log</h1>
      <p class="log-lede">Enter your generator details and completed service records, then print or save your filled log as a PDF. Entries are homeowner-provided, not proof that service was performed.</p>
      <div class="log-actions no-print">
        <button type="button" id="download-log" class="button log-download-button" hidden>Generate PDF <span aria-hidden="true">↓</span></button>
        <button type="button" id="print-log" class="button log-print-button">Print / Save as PDF <span aria-hidden="true">↗</span></button>
        <button type="button" id="clear-log" class="log-clear-button">Clear entries</button>
        <a href="/maintenance/model-service-schedules/" class="log-secondary-link">See model-specific schedules <span aria-hidden="true">→</span></a>
      </div>
      <p class="log-download-status no-print" id="log-download-status" role="status" aria-live="polite"></p>
      <p class="log-privacy no-print" id="log-privacy">Your draft stays in this browser tab session only. Nothing is uploaded to our website. Generate PDF downloads a copy to your device. Save it before closing the tab.</p>
      <p class="log-safety">Follow the exact generator manual. Arrange qualified service for tasks outside the manufacturer's owner instructions.</p>
    </header>

    <section class="log-section" aria-labelledby="log-generator-title">
      <div class="log-section-heading">
        <span class="log-step" aria-hidden="true">01</span>
        <div>
          <h2 id="log-generator-title">Generator details</h2>
          <p>Complete once and update whenever details change.</p>
        </div>
      </div>
      <dl class="log-identity">
        {generatorDetails.map((label, index) => {
          const key = `detail-${index}`;
          const id = `log-detail-${index}`;
          return (
            <div class="identity-field">
              <dt><label for={id}>{label}</label></dt>
              <dd>
                <input id={id} class="log-editable" data-record-key={key} type="text" maxlength="200" autocomplete="off" placeholder="Enter details" />
                <span class="log-print-value" data-print-key={key} aria-hidden="true"></span>
              </dd>
            </div>
          );
        })}
      </dl>
    </section>

    <section class="log-section" aria-labelledby="log-record-title">
      <div class="log-section-heading">
        <span class="log-step" aria-hidden="true">02</span>
        <div>
          <h2 id="log-record-title">Service &amp; inspection entries</h2>
          <p>Record actual observations or completed work and the next due date or hour reading according to the manual.</p>
        </div>
      </div>

      <div class="log-table-wrap" role="region" tabindex="0" aria-label="Maintenance log table; scroll horizontally if necessary">
        <table class="log-table">
          <caption class="sr-only">Blank service log with 12 entries for printing</caption>
          <thead>
            <tr>{serviceFields.map((label) => <th scope="col">{label}</th>)}</tr>
          </thead>
          <tbody>
            {Array.from({ length: 12 }, (_, row) => (
              <tr>
                {serviceFields.map((field, col) => {
                  const key = `service-${row}-${col}`;
                  return (
                    <td>
                      {col === 2 ? (
                        <textarea class="log-editable log-work-input" data-record-key={key} aria-label={`Entry ${row + 1}: ${field}`} rows="2" maxlength="1000" placeholder="Enter work / observations"></textarea>
                      ) : (
                        <input class="log-editable" data-record-key={key} type="text" aria-label={`Entry ${row + 1}: ${field}`} maxlength="200" autocomplete="off" placeholder="Enter details" />
                      )}
                      <span class="log-print-value" data-print-key={key} aria-hidden="true"></span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ol class="log-card-list" aria-label="Editable service and inspection entries">
        {Array.from({ length: 12 }, (_, index) => (
          <li class="log-card">
            <details open={index === 0}>
              <summary>
                <span>Entry {String(index + 1).padStart(2, '0')}</span>
                <span class="log-card-expand" aria-hidden="true"></span>
              </summary>
              <dl>
                {serviceFields.map((label, col) => {
                  const key = `service-${index}-${col}`;
                  const id = `log-card-${index}-${col}`;
                  return (
                    <div class="log-card-field">
                      <dt><label for={id}>{label}</label></dt>
                      <dd>
                        {col === 2 ? (
                          <textarea id={id} class="log-editable log-work-input" data-record-key={key} rows="2" maxlength="1000" placeholder="Enter work / observations"></textarea>
                        ) : (
                          <input id={id} class="log-editable" data-record-key={key} type="text" maxlength="200" autocomplete="off" placeholder="Enter details" />
                        )}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </details>
          </li>
        ))}
      </ol>
      <p class="log-preview-note no-print">All 12 service entries are editable. Your completed entries also appear in the print/PDF table; blank rows remain available for handwriting.</p>
    </section>

    <p class="log-footer-note">Keep service invoices and warranty documentation together with this log. For maintenance intervals, consult the exact model and serial-number manual. <a href="/maintenance/model-service-schedules/" class="no-print">Review sourced model schedules</a>.</p>
  </article>
</BaseLayout>

<script>
  import { createMaintenancePdf } from '../../lib/maintenancePdf';

  const root = document.querySelector<HTMLElement>('.maintenance-log');
  const storageKey = 'sgg-generator-maintenance-log-session-v1';
  if (root) {
    const inputs = [...root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-record-key]')];
    const editableGroups = new Map<string, (HTMLInputElement | HTMLTextAreaElement)[]>();
    const printedGroups = new Map<string, HTMLElement[]>();
    const values: Record<string, string> = Object.create(null);

    for (const input of inputs) {
      const key = input.dataset.recordKey;
      if (!key) continue;
      if (!editableGroups.has(key)) editableGroups.set(key, []);
      editableGroups.get(key)?.push(input);
    }
    for (const span of root.querySelectorAll<HTMLElement>('[data-print-key]')) {
      const key = span.dataset.printKey;
      if (!key) continue;
      if (!printedGroups.has(key)) printedGroups.set(key, []);
      printedGroups.get(key)?.push(span);
    }

    const put = (key: string, value: string, source?: HTMLInputElement | HTMLTextAreaElement) => {
      if (!editableGroups.has(key)) return;
      values[key] = value;
      for (const input of editableGroups.get(key) ?? []) {
        if (input !== source) input.value = value;
      }
      for (const span of printedGroups.get(key) ?? []) {
        span.textContent = value;
      }
    };
    const save = () => {
      try { sessionStorage.setItem(storageKey, JSON.stringify(values)); } catch { /* Private mode may disable storage. */ }
    };
    try {
      const saved = sessionStorage.getItem(storageKey);
      const draft = saved ? JSON.parse(saved) as Record<string, unknown> : null;
      if (draft && typeof draft === 'object' && !Array.isArray(draft)) {
        for (const [key, value] of Object.entries(draft)) {
          if (typeof value === 'string' && editableGroups.has(key)) put(key, value);
        }
      }
    } catch { /* The worksheet remains functional without session storage. */ }

    root.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
      const key = target.dataset.recordKey;
      if (!key) return;
      put(key, target.value, target);
      save();
    });
    window.addEventListener('beforeprint', () => {
      for (const [key, inputsForKey] of editableGroups) {
        put(key, values[key] ?? inputsForKey[0]?.value ?? '');
      }
    });
    const downloadButton = root.querySelector<HTMLButtonElement>('#download-log');
    const downloadStatus = root.querySelector<HTMLElement>('#log-download-status');
    if (downloadButton) {
      downloadButton.hidden = false;
      downloadButton.addEventListener('click', async () => {
        downloadButton.disabled = true;
        if (downloadStatus) downloadStatus.textContent = 'Generating your PDF on this device…';
        try {
          const snapshot = (key: string) => values[key] ?? editableGroups.get(key)?.[0]?.value ?? '';
          const details = Array.from({ length: 7 }, (_, i) => snapshot(`detail-${i}`));
          const entries = Array.from({ length: 12 }, (_, row) =>
            Array.from({ length: 5 }, (_, col) => snapshot(`service-${row}-${col}`)));
          const pdf = await createMaintenancePdf({ details, entries });
          const url = URL.createObjectURL(pdf);
          const link = document.createElement('a');
          link.href = url;
          link.download = `generator-maintenance-log-${new Date().toISOString().slice(0, 10)}.pdf`;
          document.body.appendChild(link);
          link.click();
          link.remove();
          // Mobile browsers may need longer to start a file download.
          window.setTimeout(() => URL.revokeObjectURL(url), 60000);
          if (downloadStatus) downloadStatus.textContent = 'PDF generated. Check your browser downloads.';
        } catch (error) {
          console.error('Unable to generate maintenance PDF:', error);
          if (downloadStatus) downloadStatus.textContent =
            'PDF download failed. Try Print / Save as PDF instead.';
        } finally {
          downloadButton.disabled = false;
        }
      });
    }
    root.querySelector('#print-log')?.addEventListener('click', () => {
      for (const [key, group] of editableGroups) put(key, values[key] ?? group[0]?.value ?? '');
      window.print();
    });
    root.querySelector('#clear-log')?.addEventListener('click', () => {
      if (!window.confirm('Clear all generator details and service entries in this browser tab?')) return;
      for (const key of editableGroups.keys()) put(key, '');
      try { sessionStorage.removeItem(storageKey); } catch { /* Nothing is saved remotely. */ }
    });
  }
</script>

<style>
  .maintenance-log {
    max-width: 1152px;
    color: #263b33;
  }
  .log-header {
    padding: clamp(1.2rem, 3.5vw, 2.5rem);
    border: 1px solid #d9e1d9;
    border-radius: 1rem;
    background: linear-gradient(130deg, #f5f8f4, #ffffff 72%);
  }
  .log-eyebrow {
    margin: 0 0 0.65rem;
    color: #547163;
    font-size: 0.73rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .maintenance-log h1 {
    margin: 0;
    max-width: 18ch;
    color: #203b34;
    font: 500 clamp(2.15rem, 4.6vw, 3.6rem)/1.12 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.025em;
  }
  .log-lede {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: #40554c;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
  }
  .log-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
    margin-top: 1.5rem;
  }
  .log-print-button {
    gap: 1rem;
    border-radius: 0.45rem;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .log-secondary-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    gap: 0.45rem;
    padding: 0.65rem 0.2rem;
    color: #265344;
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .log-safety {
    max-width: 68ch;
    margin: 1.2rem 0 0;
    padding-left: 0.9rem;
    border-left: 3px solid #d2a45d;
    color: #506055;
    font-size: 0.91rem;
    line-height: 1.6;
  }
  .log-section {
    min-width: 0;
    margin-top: 2rem;
  }
  .log-section-heading {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-bottom: 1.1rem;
  }
  .log-step {
    display: grid;
    flex: 0 0 2.3rem;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: #203b34;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 750;
  }
  .maintenance-log .log-section-heading h2 {
    margin: 0;
    color: #203b34;
    font: 500 clamp(1.6rem, 3vw, 2rem)/1.2 Georgia, 'Times New Roman', serif;
  }
  .log-section-heading p {
    margin: 0.35rem 0 0;
    color: #53675d;
    font-size: 0.93rem;
    line-height: 1.6;
  }
  .log-identity {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem 1rem;
    margin: 0;
  }
  .identity-field {
    min-width: 0;
    padding: 0.85rem 1rem 0.6rem;
    border: 1px solid #dde5de;
    border-radius: 0.6rem;
    background: #fafbf9;
  }
  .identity-field dt {
    color: #345246;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .identity-field dd {
    position: relative;
    min-height: 1.6rem;
    margin: 0.35rem 0 0;
    border-bottom: 1px solid #b3c0b7;
  }
  .log-table-wrap {
    overflow-x: auto;
    border: 1px solid #dbe4dd;
    border-radius: 0.75rem;
  }
  .log-table {
    width: 100%;
    min-width: 780px;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.88rem;
  }
  .log-table th {
    padding: 0.9rem 0.75rem;
    border: 1px solid #33584b;
    background: #203b34;
    color: #fff;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-align: left;
  }
  .log-table td {
    height: 3.4rem;
    padding: 0.6rem;
    border: 1px solid #dce4dc;
    background: #fff;
    vertical-align: top;
  }
  .log-table tbody tr:nth-child(even) td { background: #f8faf8; }
  /* All twelve entries remain editable on desktop; the print sheet mirrors every field. */
  .log-table th:nth-child(1) { width: 12%; }
  .log-table th:nth-child(2) { width: 12%; }
  .log-table th:nth-child(3) { width: 34%; }
  .log-table th:nth-child(4) { width: 18%; }
  .log-table th:nth-child(5) { width: 24%; }
  .log-card-list { display: none; }
  .log-preview-note {
    margin: 0.8rem 0 0;
    color: #4b6256;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .log-footer-note {
    margin: 2rem 0 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid #d2a45d;
    background: #f8f8f3;
    color: #46594f;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .log-footer-note a { color: #265344; text-decoration: underline; }
  @media screen and (max-width: 1199px) {
    .log-table-wrap { display: none !important; }
    .log-card-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    .log-card {
      min-width: 0;
      padding: 1rem 1.15rem;
      border: 1px solid #d9e2da;
      border-radius: 0.9rem;
      background: #fff;
      box-shadow: 0 4px 18px rgba(19, 43, 31, 0.035);
    }
    .log-card h3 {
      margin: 0 0 0.35rem;
      padding-bottom: 0.65rem;
      border-bottom: 2px solid #254d3d;
      color: #234234;
      font-size: 1.05rem;
      line-height: 1.4;
      font-weight: 750;
    }
    .log-card dl { margin: 0; }
    .log-card-field { padding: 0.55rem 0 0.45rem; }
    .log-card-field + .log-card-field { border-top: 1px solid #edf0ec; }
    .log-card-field dt {
      color: #345547;
      font-size: 0.81rem;
      line-height: 1.4;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
    .log-card-field dd {
      min-height: 1.75rem;
      margin: 0.3rem 0 0;
      border-bottom: 1px solid #aebdb2;
    }
  }
  @media screen and (max-width: 719px) {
    .log-identity, .log-card-list { grid-template-columns: minmax(0, 1fr); }
    .log-header { padding: 1.25rem; }
    .maintenance-log h1 { font-size: clamp(2rem, 8.5vw, 2.65rem); }
    .log-section { margin-top: 1.6rem; }
  }
  @media print {
    .maintenance-log {
      max-width: none;
      width: 100%;
      padding: 0 !important;
      color: #000;
    }
    .log-header { padding: 0 0 0.4rem; border: 0; border-radius: 0; background: #fff; }
    .log-eyebrow { color: #444; font-size: 8pt; }
    .maintenance-log h1 { color: #000; font-size: 22pt; }
    .log-lede, .log-safety, .log-section-heading p, .log-preview-note, .log-actions, .log-footer-note a { display: none !important; }
    .log-section { margin-top: 0.55rem; }
    .log-section-heading { margin-bottom: 0.45rem; }
    .maintenance-log .log-section-heading h2 { font-size: 13pt; color: #000; }
    .log-step { width: 1.5rem; height: 1.5rem; flex-basis: 1.5rem; font-size: 8pt; }
    .log-identity { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.35rem 0.6rem; }
    .identity-field { padding: 0.3rem 0.55rem; border-radius: 0; background: #fff; }
    .identity-field dt { font-size: 8pt; color: #000; }
    .identity-field dd { min-height: 0.95rem; margin-top: 0.15rem; border-color: #555; }
    .log-card-list { display: none !important; }
    .log-table-wrap { display: block !important; overflow: visible !important; border-radius: 0; border: 0; }
    .log-table { display: table; min-width: 0; font-size: 8pt; }
    .log-table thead { display: table-header-group; }
    .log-table tr { display: table-row; break-inside: avoid; }
    .log-table th { background: #eee !important; color: #000 !important; border: 1px solid #555; padding: 0.45rem; }
    .log-table td { height: 2.4rem; background: #fff !important; border: 1px solid #888; }
    .log-table tbody tr:nth-child(n+5) { display: table-row; }
    .log-footer-note { margin-top: 0.45rem; padding: 0.3rem 0; border: 0; background: #fff; font-size: 8pt; }
  }

  .log-privacy {
    margin: .95rem 0 0;
    color: #4c6756;
    font-size: .82rem;
    line-height: 1.6;
  }
  .log-download-button[hidden] { display: none !important; }
  .log-download-button {
    min-height: 44px;
    border: 1px solid #203b34;
    background: #203b34;
    color: #fff;
    cursor: pointer;
  }
  .log-download-button:hover { background: #385949; }
  .log-download-button:disabled { opacity: .6; cursor: wait; }
  .log-download-button:focus-visible { outline: 3px solid #d69c52; outline-offset: 3px; }
  .log-download-status {
    min-height: 1.4rem;
    margin: .55rem 0 0;
    color: #305341;
    font-size: .82rem;
  }
  .log-download-status:empty { display: none; }
  .log-clear-button {
    min-height: 44px;
    padding: .6rem .85rem;
    border: 1px solid #bdccc1;
    border-radius: .45rem;
    color: #2e5340;
    background: #fff;
    font-family: inherit;
    font-size: .87rem;
    font-weight: 700;
    line-height: 1.45;
    cursor: pointer;
  }
  .log-clear-button:hover { background: #f0f6f0; }
  .log-clear-button:focus-visible, .log-card summary:focus-visible, .log-editable:focus-visible {
    outline: 3px solid #d69c52;
    outline-offset: 2px;
  }
  .log-editable {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: .4rem .1rem;
    border: 0;
    border-bottom: 1px solid #a6b9a9;
    border-radius: 0;
    outline-offset: 2px;
    background: transparent;
    color: #203b34;
    font-family: inherit;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .log-editable::placeholder { color: #758a7b; opacity: 1; }
  textarea.log-editable { min-height: 2.8rem; resize: vertical; }
  .log-print-value { display: none; }
  .log-card details { margin: 0; }
  .log-card summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0 0 .65rem;
    cursor: pointer;
    list-style: none;
    border-bottom: 2px solid #254d3d;
    color: #234234;
    font-size: 1.05rem;
    line-height: 1.4;
    font-weight: 750;
  }
  .log-card summary::-webkit-details-marker { display: none; }
  .log-card summary::marker { content: ''; }
  .log-card-expand::before { content: '+'; font-size: 1.25rem; font-weight: 400; }
  .log-card details[open] .log-card-expand::before { content: '−'; }
  .log-card details > dl { padding-top: .4rem; }
  .log-table td .log-editable { font-size: .8rem; }
  @media print {
    .log-editable { display: none !important; }
    .log-print-value {
      display: block !important;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      color: #000;
      font: 9pt/1.4 Arial, sans-serif;
      min-height: 1em;
    }
    .identity-field dd { min-height: 1.1rem; }
    .log-table td { padding: .38rem !important; vertical-align: top; }
    .log-privacy, .log-clear-button { display: none !important; }
  }
</style>
