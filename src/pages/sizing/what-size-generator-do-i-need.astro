const toc = [
  { id: 'start-with-purpose', label: 'Start with the backup goal' },
  { id: 'terms', label: 'Running and starting demand' },
  { id: 'process', label: 'A safe sizing process' },
  { id: 'worked-example', label: 'A sourced worked example' },
  { id: 'fuel-ratings', label: 'Fuel and model ratings' },
  { id: 'planning-sheet', label: 'Information to gather' },
  { id: 'professional-review', label: 'When professional review is essential' },
  { id: 'faq', label: 'Common questions' },
];
const find = (name: string) => {
  const result = appliances.find((appliance) => appliance.name === name);
  if (!result) throw new Error(`Missing appliance reference: ${name}`);
  return result;
};
const refrigerator = find('Refrigerator');
const ac = find('Central air conditioner, 3 ton');
const wellPump = find('Well pump, 1/2 HP');
const furnaceFan = find('Furnace fan, 1/2 HP');
const ledBulb = find('LED light bulb (each)');
const router = find('Internet router and modem');
const runningUpper = refrigerator.runningWatts.maximum + ac.runningWatts.maximum + wellPump.runningWatts.maximum + furnaceFan.runningWatts.maximum + ledBulb.runningWatts.maximum * 10 + router.runningWatts.maximum;
const acStartsAlone = runningUpper - ac.runningWatts.maximum + (ac.startingWatts?.maximum ?? 0);
const pumpStartsAlone = runningUpper - wellPump.runningWatts.maximum + (wellPump.startingWatts?.maximum ?? 0);
const bothStartTogether = runningUpper - ac.runningWatts.maximum - wellPump.runningWatts.maximum + (ac.startingWatts?.maximum ?? 0) + (wellPump.startingWatts?.maximum ?? 0);
const faqs = [
  { q: 'What size generator do I need for a 2,000-square-foot home?', a: 'Square footage cannot determine the required capacity. Heating fuel, HVAC equipment and startup data, well or sump pumps, electric appliances, selected circuits, and the generator fuel all matter. Use this guide to gather information, then have a qualified local professional assess the actual system.' },
  { q: 'Can I just add the starting watts printed in a chart?', a: 'No. Starting demand is momentary, and the result depends on which loads are already running, which motors start together, and the actual equipment. A generic chart is a rough reference only; use manufacturer nameplates/manuals and a professional load analysis.' },
  { q: 'Should I add a fixed percentage for headroom?', a: 'There is no single percentage that replaces an equipment-specific load analysis. Do not add an arbitrary margin to an uncertain chart total and treat it as a final generator size. Ask the designer to explain the running load, motor-start assumptions, fuel-specific capacity, site conditions, and any load management.' },
  { q: 'Do standby generators have the same output on propane and natural gas?', a: 'Not necessarily. Many dual-fuel models have different published ratings by fuel. Check the exact model and fuel in the manufacturer specification sheet and the planned site supply.' },
  { q: 'Is there a calculator on this site?', a: 'Yes. Our separate load-planning tool calculates illustrative scenarios from your equipment inputs. It is not a final sizing calculation or an automatic model recommendation. This page also retains a static worksheet.' },
];
