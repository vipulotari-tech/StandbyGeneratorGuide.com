---
import BrandLogo from './BrandLogo.astro';
const nav = [
  {href:'/guides/first-time-buyer-guide/',label:'Start here'},
  {href:'/sizing/',label:'Sizing'},
  {href:'/cost/',label:'Costs'},
  {href:'/comparisons/',label:'Compare'},
  {href:'/brands/',label:'Brands'},
  {href:'/installation/',label:'Installation'},
  {href:'/maintenance/',label:'Ownership'},
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-primary text-white shadow-sm">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-2 px-4 py-2 sm:gap-4 sm:px-6">
    <a href="/" class="flex min-h-[44px] items-center gap-2.5" aria-label="Standby Generator Guide home"><BrandLogo inverse /></a>
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class={`border-b-2 border-transparent px-2.5 py-2.5 text-[13px] font-semibold text-slate-200 transition-colors hover:border-white/30 hover:text-white ${active(n.href) ? 'border-accent text-white' : ''}`}>{n.label}</a>)}
    </nav>
    <a href="/planning/" class="hidden min-h-[44px] items-center border border-white/35 px-3 text-[13px] font-bold text-white hover:bg-white/10 xl:inline-flex">Planning tools</a>
    <button id="menu-btn" class="inline-flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-sm border border-white/30 text-white transition-colors hover:bg-white/10 lg:hidden" aria-expanded="false" aria-controls="mobile-nav">
      <span id="menu-label" class="sr-only">Open navigation menu</span><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-white/10 bg-primary lg:hidden" aria-label="Mobile">
    <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6"><p class="mb-2 text-[11px] font-bold uppercase tracking-[.14em] text-orange-200">Research by decision</p><ul class="grid grid-cols-2 gap-x-2 gap-y-1">
      {nav.map((n) => <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class={`block min-h-[44px] border-l-2 border-transparent px-3 py-3 text-[14px] font-semibold text-slate-200 hover:bg-white/10 hover:text-white ${active(n.href) ? 'border-accent bg-white/10 text-white' : ''}`}>{n.label}</a></li>)}
    </ul><div class="mt-3 border-t border-white/15 pt-3"><a href="/planning/" class="flex min-h-[48px] items-center justify-between border border-white/30 px-3 font-semibold text-white">Open planning tools <span aria-hidden="true">→</span></a><div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm"><a href="/models/" class="py-2 text-white underline underline-offset-4">Exact models</a><a href="/research/" class="py-2 text-white underline underline-offset-4">Research &amp; sources</a></div></div></div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  const label = document.getElementById('menu-label');

  const closeMenu = (restoreFocus = false) => {
    if (!nav || nav.classList.contains('hidden')) return;
    nav.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    if (label) label.textContent = 'Open navigation menu';
    if (restoreFocus) (btn as HTMLElement | null)?.focus();
  };
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
    if (open) (nav?.querySelector('a') as HTMLElement | null)?.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu(true);
  });
  // Tapping the article outside the open mobile menu should dismiss it.
  document.addEventListener('pointerdown', (event) => {
    const target = event.target;
    if (!(target instanceof Node) || !nav || !btn) return;
    if (!nav.contains(target) && !btn.contains(target)) closeMenu();
  });
  // Prevent a stale expanded state after rotating or resizing to desktop.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) closeMenu();
  });
</script>