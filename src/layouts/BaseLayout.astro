---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { IS_INDEXABLE, SITE_URL, SITE_NAME } from '../config/site';
import { SEARCH_METADATA } from '../config/search-metadata';

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  seoTitle,
  seoDescription,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;
const site = SITE_URL;
const url = canonical ?? `${site}${Astro.url.pathname}`;
const indexable = IS_INDEXABLE && !noindex;
const searchMetadata = SEARCH_METADATA[Astro.url.pathname];
const fullTitle = seoTitle ?? searchMetadata?.title ?? (title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`);
const searchDescription = seoDescription ?? searchMetadata?.description ?? description;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
const pageSchema = indexable ? (schema ?? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url,
  publisher: { '@type': 'Organization', name: SITE_NAME, url: `${site}/` },
}) : undefined;
---
<!doctype html>
<html lang="en-US">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-D93DLV65RB"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-D93DLV65RB');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#203b34" />
  <noscript><style>@media (max-width: 1023px) { #menu-btn { display: none !important; } #mobile-nav { display: block !important; } }</style></noscript>
  <title>{fullTitle}</title>
  <meta name="description" content={searchDescription} />
  {indexable && <link rel="canonical" href={url} />}
  <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={searchDescription} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={searchDescription} />
  <meta name="twitter:image" content={absoluteOgImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {indexable && <link rel="sitemap" href="/sitemap-index.xml" />}
  {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema).replace(/</g, '\\u003c')} />}
</head>
<body class="flex min-h-screen flex-col bg-white text-ink">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-primary">Skip to content</a>
  <Header />
  <main id="main" class="flex-1">
    <slot />
  </main>
  <Footer />
  <script>
    // Keyboard-only focus rings: hide outlines for pointer interaction, restore
    // them immediately when the user resumes keyboard navigation.
    document.documentElement.addEventListener('mousedown', () => document.documentElement.classList.add('mouse-nav'), { passive: true });
    document.documentElement.addEventListener('touchstart', () => document.documentElement.classList.add('mouse-nav'), { passive: true });
    document.documentElement.addEventListener('keydown', (e) => { if (e.key === 'Tab') document.documentElement.classList.remove('mouse-nav'); });

    // On small screens, wide comparison tables become readable labeled cards.
    // The original semantic table remains the source of truth; labels come from
    // its column headers so future copy changes do not require duplicate markup.
    document.querySelectorAll('table.mobile-card-table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th')).map((header) =>
        header.textContent?.trim() ?? ''
      );
      table.querySelectorAll('tbody tr').forEach((row) => {
        Array.from(row.children).forEach((cell, index) => {
          if (cell instanceof HTMLElement && headers[index] && !cell.dataset.label) {
            cell.dataset.label = headers[index];
          }
        });
      });
    });
    // Enable the card presentation only after every visible cell has its
    // source header label. Without JS, the native semantic table stays readable.
    document.documentElement.classList.add('enhanced-tables');
  </script>
</body>
</html>
