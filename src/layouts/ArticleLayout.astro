---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import DataDisclaimer from '../components/ui/DataDisclaimer.astro';
import TechnicalReviewPanel from '../components/trust/TechnicalReviewPanel.astro';
import SourceVerificationPanel from '../components/trust/SourceVerificationPanel.astro';
import MethodBox from '../components/article/MethodBox.astro';
import { SITE_URL, SITE_NAME, AUTHOR } from '../config/site';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import AdUnit from '../components/ads/AdUnit.astro';

interface TocItem { id: string; label: string; }
interface Related { href: string; title: string; description: string; category?: string; }
interface Source { label: string; href: string; type?: 'Manufacturer' | 'Government' | 'Safety authority' | 'Safety organization' | 'Technical manual' | 'Standards organization' | 'Industry'; verified?: string; }
interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  category: string;
  categoryHref: string;
  updated?: string;
  readingTime: string;
  toc: TocItem[];
  related?: Related[];
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
  takeaways?: string[];
  sources?: Source[];
  image?: string;
  published?: string;
  verified?: string;
  showMethod?: boolean;
}
const { title, description, seoTitle, seoDescription, category, categoryHref, updated, readingTime, toc, related = [], prev, next, takeaways = [], sources = [], image, published, verified, showMethod = true } = Astro.props;

const researchDeskByCategory: Record<string, string> = {
  'Sizing': 'Sizing Research Desk',
  'Cost': 'Cost & Ownership Research Desk',
  'Brands': 'Model Research Desk',
  'Models': 'Model Research Desk',
  'Comparisons': 'Comparison Research Desk',
  'Installation': 'Installation Research Desk',
  'Maintenance': 'Maintenance Research Desk',
  'Guides': 'Buyer Education Desk',
  'Buying Guides': 'Buyer Education Desk',
  'Research': 'Research Desk',
};
const researchByline = researchDeskByCategory[category] ?? AUTHOR.name;
const site = SITE_URL;
const url = `${site}${Astro.url.pathname}`;
const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric', day: 'numeric' });
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: category, item: site + categoryHref },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: researchByline, url: AUTHOR.url },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/logo.svg` },
  },
  mainEntityOfPage: url,
};
if (published) articleSchema.datePublished = published;
if (updated) articleSchema.dateModified = updated;
if (image) articleSchema.image = `${site}${image}`;
// Deliberately no FAQPage/HowTo schema: FAQ rich results are restricted and
// HowTo has strict eligibility — plain Article + Breadcrumb only.
---
<BaseLayout title={title} description={description} seoTitle={seoTitle} seoDescription={seoDescription} ogImage={image} ogType="article" schema={[articleSchema, breadcrumbSchema]}>
  <div class="article-publication">
    <header class="article-masthead">
      <div class="article-shell">
        <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: categoryHref, label: category }, { label: title }]} />
        <div class="article-masthead-copy">
          <a class="article-category" href={categoryHref}>{category}<span aria-hidden="true"> / Research guide</span></a>
          <h1>{title}</h1>
          <p class="article-deck">{description}</p>
          <div class="article-meta" aria-label="Article information">
            <span>By <a href={AUTHOR.url}>{researchByline}</a></span>
            {published && <span>Published <time datetime={published}>{fmtDate(published)}</time></span>}
            {updated && <span>Updated <time datetime={updated}>{fmtDate(updated)}</time></span>}
            <span>{readingTime}</span>
            {sources.length > 0 && <a href="#sources-heading">{sources.length} linked sources ↗</a>}
          </div>
        </div>
        {image && (
          <figure class="article-cover">
            <img src={image} alt="" width="1440" height="810" loading="eager" decoding="async" fetchpriority="high" />
            <figcaption>Illustrative editorial image. Product and installation details must be verified for your specific project.</figcaption>
          </figure>
        )}
      </div>
    </header>

    <div class="article-shell article-editorial-grid">
      <article class="article-main min-w-0">
        {takeaways.length > 0 && (
          <section class="article-takeaways" aria-labelledby="article-takeaways-heading">
            <div class="article-section-eyebrow"><span aria-hidden="true" class="article-eyebrow-mark">✦</span> The essential briefing</div>
            <h2 id="article-takeaways-heading">Key takeaways</h2>
            <ul>
              {takeaways.map((takeaway) => <li><span class="article-takeaway-copy">{takeaway}</span></li>)}
            </ul>
          </section>
        )}

        <section class="article-evidence" aria-labelledby="article-evidence-title">
          <div class="article-evidence-topline">
            <div>
              <p class="article-section-eyebrow">Evidence &amp; review transparency</p>
              <h2 id="article-evidence-title">What informs this guide</h2>
            </div>
            {sources.length > 0 && <a class="article-view-sources" href="#sources-heading">View all sources <span aria-hidden="true">↗</span></a>}
          </div>
          <p class="article-evidence-intro">{sources.length > 0 ? "Research draws on the linked documents below. Source checks do not establish independent testing, licensed professional review, or suitability for your home." : "This guide has no linked source list. Treat its planning framework as editorial guidance and confirm technical details with current official documents and qualified local professionals."}</p>
          {sources.length > 0 && (
            <div class="article-evidence-links">
              {sources.slice(0, 2).map((source) => (
                <a href={source.href} rel="external noopener noreferrer" class="article-evidence-source">
                  <span class="article-evidence-source-type">{source.type ?? 'Published source'}</span>
                  <strong>{source.label}</strong>
                  <span class="article-evidence-source-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
          <TechnicalReviewPanel />
          {showMethod && <MethodBox verified={verified ? fmtDate(verified) : undefined} />}
        </section>

        {toc.length > 0 && (
          <div class="article-mobile-navigation lg:hidden">
            <details>
              <summary>Explore sections <span aria-hidden="true">↓</span></summary>
              <TableOfContents items={toc} />
            </details>
          </div>
        )}

        <AdUnit placement="article-after-intro" minHeight={200} />
        <div id="article-content" class="prose-hgg article-prose">
          <slot />
        </div>
        <DataDisclaimer category={category} />
        <div class="article-ad-space"><AdUnit placement="article-mid" minHeight={280} /></div>

        {sources.length > 0 && (
          <section class="article-source-library" aria-labelledby="sources-heading">
            <div class="article-section-eyebrow">Trace the evidence</div>
            <h2 id="sources-heading">Sources &amp; further reading</h2>
            <SourceVerificationPanel date={verified} count={sources.length} />
            <ol>
              {sources.map((source, index) => (
                <li>
                  <span class="article-source-number">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <a href={source.href} rel="external noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a>
                    <p>{source.type ?? 'Published source'}{source.verified ? ' · Link checked ' + source.verified : ''}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="article-source-note">Manufacturer specifications and regulatory requirements may change. Check the current official documents and consult qualified local professionals before committing to a system.</p>
          </section>
        )}

        <div class="article-author-note"><AuthorBox /></div>
        {(prev || next) && (
          <nav aria-label="Previous and next guides" class="article-prev-next">
            {prev && <a href={prev.href}><span>Previous guide</span><strong>← {prev.label}</strong></a>}
            {next && <a href={next.href}><span>Next guide</span><strong>{next.label} →</strong></a>}
          </nav>
        )}
        <RelatedArticles articles={related} />
        <div class="article-ad-space"><AdUnit placement="article-end" minHeight={250} /></div>
      </article>

      <aside class="article-sidebar hidden lg:block" aria-label="Article navigation and editorial notes">
        <div class="article-sidebar-inner">
          {toc.length > 0 && <TableOfContents items={toc} />}
          <AdUnit placement="sidebar" minHeight={300} />
          <AuthorBox />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
